# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PERSISTENCE (Render.com Persistent Disks or custom server paths)
# Caso utilize um Persistent Disk no Render.com ou volume persistente Docker (ex: /var/data),
# você pode definir estas variáveis no dashboard para persistir o banco e mídias entre deploys:
# DATA_DIR="/var/data"
# UPLOAD_DIR="/var/data/uploads"
# UPLOADS_DIR="/var/data/uploads"
# (No AI Studio ou ambiente padrão, caso não definidas, o sistema usa ./data e ./uploads locais com sincronização em nuvem via Firestore)

# FIREBASE FIRESTORE CLOUD PERSISTENCE
# NOTA: O applet já inclui o arquivo 'firebase-applet-config.json' na raiz do projeto com
# todas as credenciais ativas e funcionais para o Firestore.
# Você NÃO precisa preencher estas variáveis no AI Studio!
#
# Caso vá fazer deploy externo no Render.com sem incluir o arquivo JSON no repositório Git,
# você pode copiar e colar os seguintes valores nas variáveis de ambiente do Render:
# FIREBASE_PROJECT_ID="deep-freedom-8szp9"
# FIREBASE_API_KEY="AIzaSyCzP6rv9WIneoF9OUDTRppATOsCLOS-vvQ"
# FIRESTORE_DATABASE_ID="ai-studio-remixmdiaindoor2-b21786e5-9cc2-4541-8854-9ca7fb6c84ba"
# FIREBASE_APP_ID="1:676316244483:web:bc8f3491e953b884c9fc36"
# FIREBASE_AUTH_DOMAIN="deep-freedom-8szp9.firebaseapp.com"

# DECOUPLED STATIC SITE ARCHITECTURE (Opcional)
# Caso decida hospedar o Frontend como Static Site separado do Backend Node.js:
# VITE_API_BASE_URL="https://sua-api-backend.onrender.com/api"

# CLOUDFLARE R2 OBJECT STORAGE (Armazenamento Permanente de Mídias e Vídeos)
# Permite salvar automaticamente todas as imagens e vídeos no Cloudflare R2 com tráfego 100% grátis (0 egress)
# Pode ser configurado aqui no .env OU diretamente no painel do sistema (Aba Configurações Cloudflare R2).
# R2_ACCOUNT_ID="seu_account_id_do_cloudflare_32_chars"
# R2_ACCESS_KEY_ID="sua_access_key_id"
# R2_SECRET_ACCESS_KEY="sua_secret_access_key"
# R2_BUCKET_NAME="indoor-midia"
# R2_PUBLIC_DOMAIN="https://pub-xxxxxx.r2.dev" (ou domínio personalizado ex: "https://midia.seudominio.com.br")


