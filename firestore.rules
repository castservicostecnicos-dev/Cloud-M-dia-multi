rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStandardAppData(data) {
      return data.keys().hasAll(['version', 'updated_at', 'stats', 'data']) &&
        data.keys().hasOnly(['version', 'updated_at', 'stats', 'data']) &&
        data.version is number &&
        data.updated_at is string && data.updated_at.size() <= 64 &&
        data.stats is map &&
        data.data is string && data.data.size() <= 1048576;
    }

    function isValidChunkedHeader(data) {
      return data.keys().hasAll(['version', 'updated_at', 'chunked', 'chunkCount', 'stats']) &&
        data.keys().hasOnly(['version', 'updated_at', 'chunked', 'chunkCount', 'stats']) &&
        data.version is number &&
        data.updated_at is string && data.updated_at.size() <= 64 &&
        data.chunked is bool &&
        data.chunkCount is number && data.chunkCount >= 1 && data.chunkCount <= 500 &&
        data.stats is map;
    }

    function isValidDataChunk(data) {
      return data.keys().hasAll(['updated_at', 'data']) &&
        data.updated_at is string && data.updated_at.size() <= 64 &&
        data.data is string && data.data.size() <= 1048576 &&
        data.keys().size() <= 4;
    }

    function isValidMediaMeta(data) {
      return data.keys().hasAll(['filename', 'totalChunks', 'size', 'updated_at']) &&
        data.keys().hasOnly(['filename', 'totalChunks', 'size', 'updated_at']) &&
        data.filename is string && data.filename.size() <= 256 &&
        data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 100 &&
        data.size is number && data.size >= 0 && data.size <= 52428800 &&
        data.updated_at is string && data.updated_at.size() <= 64;
    }

    function isValidAppData(data) {
      return isValidStandardAppData(data) ||
        isValidChunkedHeader(data) ||
        isValidDataChunk(data) ||
        isValidMediaMeta(data);
    }

    match /app_data/{docId} {
      allow get, list: if isValidId(docId);
      allow create, update: if isValidId(docId) && isValidAppData(request.resource.data);
    }

    match /system_meta/{metaId} {
      allow get: if isValidId(metaId);
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
    }
  }
}

